      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var">
        <mapperTableEntries name="nom_ar" expression="row2.adm2_name1 == null ? null : row2.adm2_name1.replace(&quot;\u0640&quot;, &quot;&quot;).trim() " type="id_String"/>
        <mapperTableEntries name="motif_controle" expression="(row2.adm2_pcode == null || !row2.adm2_pcode.matches(&quot;TN[1-6][1-9]&quot;) ? &quot;P-code absent ou mal forme ; &quot; : &quot;&quot;)&#xD;&#xA;+ (row2.adm1_pcode == null || row2.adm2_pcode == null || !row2.adm2_pcode.startsWith(row2.adm1_pcode) ? &quot;P-code hors de sa region HDX ; &quot; : &quot;&quot;)&#xD;&#xA;+ (row2.adm2_name == null || row2.adm2_ref_name == null ? &quot;Nom francais ou sans accents manquant ; &quot; : &quot;&quot;)&#xD;&#xA;+ (Var.nom_ar == null || Var.nom_ar.isEmpty() ? &quot;Nom arabe manquant ; &quot; : &quot;&quot;)&#xD;&#xA;+ (row2.area_sqkm == null || row2.area_sqkm &lt;= 0 ? &quot;Superficie manquante ou nulle ; &quot; : &quot;&quot;)&#xD;&#xA;+ (row2.center_lat == null || row2.center_lon == null || row2.center_lat &lt; 30 || row2.center_lat > 38 || row2.center_lon &lt; 7 || row2.center_lon > 12 ? &quot;Centroide hors de la Tunisie ; &quot; : &quot;&quot;)&#xD;&#xA;+ (row4.sha256 == null || !row4.sha256.matches(&quot;[0-9a-f]{64}&quot;) ? &quot;Empreinte SHA-256 invalide ; &quot; : &quot;&quot;) " type="id_String"/>
      </varTables>
      <outputTables sizeState="INTERMEDIATE" name="dim" expressionFilter="Var.motif_controle.isEmpty()" activateExpressionFilter="true">
