        <mapperTableEntries name="motif" expression="(Var.libelle_normalise == null ? &quot;Libelle vide ; &quot; : &quot;&quot;) + (pcodes_connus.pcode == null ? &quot;P-code inconnu dans dim_gouvernorat ; &quot; : &quot;&quot;) + (libelles.type_libelle == null || !libelles.type_libelle.matches(&quot;nom_fr|nom_ar|nom_ascii|variante&quot;) ? &quot;Type de libelle invalide ; &quot; : &quot;&quot;) + (libelles.source == null || libelles.source.trim().isEmpty() || libelles.tableau == null || libelles.tableau.trim().isEmpty() ? &quot;Portee source ou tableau manquante ; &quot; : &quot;&quot;)" type="id_String"/>
